# ─────────────────────────────────────────────────────────────────────────────
# Circuit Retail ERP — Environment Configuration
# ─────────────────────────────────────────────────────────────────────────────

# SQLite Database connection URL.
# Prisma resolves relative paths against the prisma/ directory.
# Local development: file:./db/custom.db (or file:../db/custom.db)
# Docker / Production: file:/app/db/custom.db
# Vercel / Serverless Preview: file:/tmp/custom.db
DATABASE_URL="file:./db/custom.db"

# Optional secret token to protect demo data re-seeding endpoint (POST /api/seed).
# If unset in production, POST /api/seed returns 403 Forbidden.
# SEED_TOKEN="your-random-secret-token-here"

# Public application URL (used for absolute URLs, canonical tags, and metadata).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Application HTTP server port (defaults to 3000 if unset).
PORT=3000
